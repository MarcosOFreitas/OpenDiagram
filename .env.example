# Copy to .env (docker compose reads it automatically). Never commit .env.

# REQUIRED in any shared/production deployment.
# Key used to encrypt saved connection secrets (passwords, CA PEMs) with AES-256-GCM.
# Changing it makes already-saved connections unreadable. Generate with: openssl rand -hex 32
APP_SECRET=change-me

# Optional (defaults shown). Inside the container these are set by the Dockerfile.
# PORT=3000
# DATA_DIR=/data
