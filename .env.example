# Copy to .env (docker compose reads it automatically). Never commit .env.

# REQUIRED in any shared/production deployment.
# Key used to encrypt saved connection secrets (passwords, CA PEMs) with AES-256-GCM.
# Changing it makes the saved passwords unreadable (the app then asks for them again). Generate with: openssl rand -hex 32
# Left empty, the app falls back to a PUBLIC development key and warns at startup: only acceptable for a local trial.
# With COOKIE_SECURE=1, DB_HOST_POLICY other than open, or REQUIRE_APP_SECRET=1 it refuses to start without one.
APP_SECRET=

# Accounts and exposure (see .specs/09-accounts-sharing.md and .specs/05-security.md)
# ALLOW_SIGNUP=             # empty = the administrator decides (default: closed after the first account); 1 = open; 0 = forced closed
# DB_HOST_POLICY=open       # open | public-only | allowlist  (use public-only when hosting for other people)
# DB_HOST_ALLOWLIST=        # comma separated host names, only with DB_HOST_POLICY=allowlist
# COOKIE_SECURE=0           # 1 when served over HTTPS (also automatic behind x-forwarded-proto: https)
# TRUST_PROXY=0             # 1 behind a reverse proxy, so rate limits use the real client IP and the request check reads X-Forwarded-Host

# Daily automatic backups inside the data volume (copy them off the machine yourself; see the Self-hosting page)
# BACKUP_DIR=backups        # empty = off; a relative folder is inside /data
# BACKUP_KEEP_DAYS=7

# Development and tests only: uncomment both lines so that `docker compose ...` also uses the demo databases (docker-compose.demo.yml).
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.demo.yml
# To run tools/test-oracle-tls.mjs the app must also trust the demo certificate of demo-oracle-tls. That certificate's private key is public,
# so never on an instance other people use: COMPOSE_FILE=docker-compose.yml:docker-compose.demo.yml:docker-compose.demo-tls.yml

# Image tag pulled by docker-compose.yml (default latest); pin a version such as 1.0.0 to update only when you choose
# OPENDIAGRAM_VERSION=latest

# PORT and DATA_DIR are not read from this file: the image sets them (3000, /data). To change the port, edit `ports:` in
# docker-compose.yml. Running the server from source (npm start), they are environment variables (defaults 3000 and ./data).
